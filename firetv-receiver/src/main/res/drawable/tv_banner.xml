<?xml version="1.0" encoding="utf-8"?>
<!-- Fire TV shows this on the home row. 320x180 is the expected aspect. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF0B1020"
                android:centerColor="#FF152A4A"
                android:endColor="#FF1D6B75"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/ic_launcher" />
</layer-list>
