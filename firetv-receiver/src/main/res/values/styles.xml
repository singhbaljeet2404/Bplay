<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BPlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="Theme.BPlay.Fullscreen" parent="Theme.BPlay">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- TV buttons need a visible focus state: there is no cursor and no touch, so the only way
         a user knows where they are is the highlight. -->
    <style name="BPlayButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
